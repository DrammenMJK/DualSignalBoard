    <text x="48"   y="272" fill="#444" font-size="14" font-family="sans-serif">41</text>
    <text x="200"  y="233" fill="#444" font-size="14" font-family="sans-serif">101</text>
    <text x="700"  y="266" fill="#444" font-size="14" font-family="sans-serif">1</text>
    <text x="700"  y="312" fill="#444" font-size="14" font-family="sans-serif">2</text>
    <text x="700"  y="376" fill="#444" font-size="14" font-family="sans-serif">3</text>
    <text x="1090" y="203" fill="#444" font-size="14" font-family="sans-serif">23</text>
    <text x="1090" y="238" fill="#444" font-size="14" font-family="sans-serif">22</text>
    <text x="1180" y="200" fill="#444" font-size="14" font-family="sans-serif">7</text>
    <text x="1360" y="140" fill="#444" font-size="14" font-family="sans-serif">21</text>
    <text x="1125" y="445" fill="#444" font-size="14" font-family="sans-serif">31</text>

