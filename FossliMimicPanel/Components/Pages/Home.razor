    <!-- F to G -->
    <line x1="1086" y1="322" x2="1158" y2="280" stroke="#888" stroke-width="8" stroke-linecap="round"/>
    <!-- G to H -->
    <line x1="1178" y1="278" x2="1254" y2="235" stroke="#888" stroke-width="8" stroke-linecap="round"/>
    <!-- Track 23 upper horizontal -->
    <line x1="1040" y1="213" x2="1184" y2="213" stroke="#888" stroke-width="8" stroke-linecap="round"/>
    <!-- Track 22 -->
    <line x1="1040" y1="247" x2="1184" y2="247" stroke="#888" stroke-width="8" stroke-linecap="round"/>
