    @((MarkupString)PensSwitch(1073, 322, "F"))
    @((MarkupString)Led(1056, 315, false))
    @((MarkupString)Led(1079, 332, false))

    <!-- ── PENS G ──────────────────────────────────────────────── -->
    @((MarkupString)PensSwitch(1167, 278, "G"))
    @((MarkupString)Led(1150, 272, false))
    @((MarkupString)Led(1173, 287, false))

    <!-- ── PENS H ──────────────────────────────────────────────── -->
    @((MarkupString)PensSwitch(1263, 233, "H"))
    @((MarkupString)Led(1247, 226, false))
    @((MarkupString)Led(1271, 240, false))

    <!-- ── PENS I ──────────────────────────────────────────────── -->
    @((MarkupString)PensSwitch(1193, 210, "I"))
    @((MarkupString)Led(1178, 212, false))
    @((MarkupString)Led(1201, 215, false))

</svg>
</div>

<style>
    .mimic-wrap {
        width: 100%;
        background: #111;
        padding: 4px;
        box-sizing: border-box;
    }
    .mimic-svg {
        width: 100%;
        height: auto;
        display: block;
    }
</style>

@code {
    // Physical analog toggle switch: metallic housing, dark recess, bat lever.
    // label=null → no label (used for Dreieskive inside the turntable circle).
    // Bat at -20° = Rett position (lever tilted upper-left).
    string PensSwitch(int cx, int cy, string? label)
    {
        const int batAngle = -20;

        string lbl = label is null ? "" :
            $"<text x=\"{cx}\" y=\"{cy + 61}\" text-anchor=\"middle\" " +
            "fill=\"#cc0000\" font-size=\"18\" font-weight=\"bold\" " +
            $"font-family=\"sans-serif\">{label}</text>";

        return
            $"<g transform=\"translate({cx},{cy})\">" +
                // Housing outer (metallic grey)
                "<rect x=\"-20\" y=\"-38\" width=\"40\" height=\"76\" rx=\"6\" " +
                    "fill=\"#b0b4bc\" stroke=\"#5a6070\" stroke-width=\"2.5\"/>" +
                // Dark recess
                "<rect x=\"-14\" y=\"-30\" width=\"28\" height=\"60\" rx=\"4\" " +
                    "fill=\"#1e2028\"/>" +
                // Bat lever
                $"<g transform=\"rotate({batAngle})\">" +
                    "<rect x=\"-5\" y=\"-26\" width=\"10\" height=\"36\" rx=\"5\" " +
                        "fill=\"#d0d4e0\" stroke=\"#909090\" stroke-width=\"1.5\"/>" +
                    // Bat head (wider rounded cap)
                    "<ellipse cx=\"0\" cy=\"-26\" rx=\"7\" ry=\"5\" " +
                        "fill=\"#e8ecf8\" stroke=\"#aaa\" stroke-width=\"1\"/>" +
                "</g>" +
            "</g>" +
            lbl;
    }

    // LED indicator: yellow when on, dark grey when off.
    string Led(int cx, int cy, bool on)
    {
        string fill   = on ? "#FFD700" : "#666";
        string stroke = on ? "#CC8800" : "#444";
        return $"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"9\" " +
               $"fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"1.5\"/>";
    }

    // Moment push-button: magenta circle with white cross.
    string MomentBtn(int cx, int cy)
    {
        return
            $"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"28\" " +
                "fill=\"#cc44cc\" stroke=\"#880088\" stroke-width=\"2.5\"/>" +
            $"<line x1=\"{cx - 12}\" y1=\"{cy}\" x2=\"{cx + 12}\" y2=\"{cy}\" " +
                "stroke=\"white\" stroke-width=\"3\"/>" +
            $"<line x1=\"{cx}\" y1=\"{cy - 12}\" x2=\"{cx}\" y2=\"{cy + 12}\" " +
                "stroke=\"white\" stroke-width=\"3\"/>";
    }
}
